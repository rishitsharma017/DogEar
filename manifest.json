{
  "manifest_version": 3,
  "name": "DogEar – Bookmarks and research projects for AI chats",
  "short_name": "DogEar",
  "version": "0.1.0",
  "description": "Capture the answers that matter in ChatGPT, Claude, Gemini, Perplexity and Grok, then find, organise and build on them.",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab", "scripting", "downloads", "alarms", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open the DogEar Library",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "24": "icons/toolbar24.png",
      "32": "icons/toolbar32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+B" },
      "description": "Show or hide the bookmarks panel"
    },
    "prev-star": {
      "suggested_key": { "default": "Alt+Up" },
      "description": "Jump to the previous starred answer in this chat"
    },
    "next-star": {
      "suggested_key": { "default": "Alt+Down" },
      "description": "Jump to the next starred answer in this chat"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*"
      ],
      "js": ["common.js", "adapters.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
